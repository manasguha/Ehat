"""
Notebook 1: Data Simulation & EDA
Run this notebook to explore the simulated charging station data.
"""

# %%
import sys
sys.path.insert(0, "../src")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from data_generator import generate_dataset, generate_peak_offpeak_scenarios

plt.rcParams["figure.figsize"] = (12, 5)
plt.rcParams["axes.grid"] = True

# %%
# Generate 90-day dataset
df = generate_dataset(num_days=90, seed=42)
print(f"Dataset shape: {df.shape}")
print(f"Days: {df['day'].nunique()}")
print(f"\nFirst 10 rows:")
df.head(10)

# %%
# Basic statistics
df.describe().round(2)

# %%
# Day type distribution
print("Day type distribution:")
print(df["day_type"].value_counts())

# %%
# Load distribution
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

axes[0].hist(df["load_kw"], bins=50, color="#2c3e50", alpha=0.7, edgecolor="white")
axes[0].set_xlabel("Load (kW)")
axes[0].set_ylabel("Frequency")
axes[0].set_title("Load Distribution")

axes[1].hist(df["vehicles"], bins=30, color="#27ae60", alpha=0.7, edgecolor="white")
axes[1].set_xlabel("Number of Vehicles")
axes[1].set_ylabel("Frequency")
axes[1].set_title("Vehicle Count Distribution")

axes[2].scatter(df["vehicles"], df["load_kw"], alpha=0.15, s=10, color="#e74c3c")
axes[2].set_xlabel("Number of Vehicles")
axes[2].set_ylabel("Load (kW)")
axes[2].set_title("Vehicles vs Load")

plt.tight_layout()
plt.savefig("../outputs/figures/eda_basic.png", dpi=150, bbox_inches="tight")
plt.show()

# %%
# Daily load curve
hourly = df.groupby("hour").agg(
    mean_load=("load_kw", "mean"),
    std_load=("load_kw", "std"),
    mean_vehicles=("vehicles", "mean"),
).reset_index()

fig, ax1 = plt.subplots(figsize=(12, 6))

ax1.fill_between(
    hourly["hour"],
    hourly["mean_load"] - hourly["std_load"],
    hourly["mean_load"] + hourly["std_load"],
    alpha=0.2, color="#2c3e50", label="±1 Std Dev",
)
ax1.plot(hourly["hour"], hourly["mean_load"], color="#2c3e50",
         linewidth=2.5, marker="o", markersize=6, label="Mean Load")
ax1.set_xlabel("Hour of Day")
ax1.set_ylabel("Load (kW)", color="#2c3e50")
ax1.set_xticks(range(0, 24, 2))
ax1.set_xticklabels([f"{h:02d}:00" for h in range(0, 24, 2)], rotation=45)

# Peak zones
ax1.axvspan(7, 11, alpha=0.08, color="#e74c3c", label="Morning Peak")
ax1.axvspan(17, 21, alpha=0.08, color="#e74c3c", label="Evening Peak")

ax2 = ax1.twinx()
ax2.plot(hourly["hour"], hourly["mean_vehicles"], color="#8e44ad",
         linewidth=1.5, linestyle="--", alpha=0.7, label="Avg Vehicles")
ax2.set_ylabel("Number of Vehicles", color="#8e44ad")

lines1, labels1 = ax1.get_legend_handles_labels()
lines2, labels2 = ax2.get_legend_handles_labels()
ax1.legend(lines1 + lines2, labels1 + labels2, loc="upper left", framealpha=0.9)

plt.title("Charging Station Daily Load Curve", fontweight="bold", pad=15)
plt.tight_layout()
plt.savefig("../outputs/figures/eda_load_curve.png", dpi=150, bbox_inches="tight")
plt.show()

# %%
# Peak vs Off-Peak comparison
df_scenarios = generate_peak_offpeak_scenarios()

fig, ax = plt.subplots(figsize=(12, 6))
for scenario, color, marker in [("Peak Day", "#e74c3c", "o"), ("Off-Peak Day", "#3498db", "s")]:
    subset = df_scenarios[df_scenarios["scenario"] == scenario]
    ax.plot(subset["hour"], subset["load_kw"], color=color,
            linewidth=2.5, marker=marker, markersize=6, label=scenario)

ax.set_xlabel("Hour of Day")
ax.set_ylabel("Load (kW)")
ax.set_xticks(range(0, 24, 2))
ax.set_xticklabels([f"{h:02d}:00" for h in range(0, 24, 2)], rotation=45)
ax.set_title("Peak vs Off-Peak Load Comparison", fontweight="bold", pad=15)
ax.legend(framealpha=0.9)
plt.tight_layout()
plt.savefig("../outputs/figures/eda_peak_offpeak.png", dpi=150, bbox_inches="tight")
plt.show()

# %%
# Load by day type
from preprocessing import add_time_features

df_feat = add_time_features(df)

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

for dt, color in [("weekday", "#e74c3c"), ("weekend", "#3498db"), ("holiday", "#8e44ad")]:
    subset = df_feat[df_feat["day_type"] == dt]
    hourly_dt = subset.groupby("hour")["load_kw"].mean()
    axes[0].plot(hourly_dt.index, hourly_dt.values, color=color, linewidth=2, label=dt)

axes[0].set_xlabel("Hour of Day")
axes[0].set_ylabel("Mean Load (kW)")
axes[0].set_title("Load by Day Type", fontweight="bold")
axes[0].legend()

# Box plot by period
periods = ["morning", "afternoon", "evening", "night"]
period_data = [df_feat[df_feat["period"] == p]["load_kw"].values for p in periods]
bp = axes[1].boxplot(period_data, labels=periods, patch_artist=True)
colors_bp = ["#3498db", "#f39c12", "#e74c3c", "#2c3e50"]
for patch, color in zip(bp["boxes"], colors_bp):
    patch.set_facecolor(color)
    patch.set_alpha(0.6)
axes[1].set_ylabel("Load (kW)")
axes[1].set_title("Load by Time Period", fontweight="bold")

plt.tight_layout()
plt.savefig("../outputs/figures/eda_daytype_period.png", dpi=150, bbox_inches="tight")
plt.show()

print("EDA complete. Figures saved to outputs/figures/")
