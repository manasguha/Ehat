"""
Notebook 2: Regression Model Training & Comparison
Trains Linear, Polynomial, and Random Forest models.
"""

# %%
import sys
sys.path.insert(0, "../src")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from data_generator import generate_dataset
from preprocessing import prepare_features, split_and_scale
from models import (
    train_linear_regression,
    train_polynomial_regression,
    train_random_forest,
    evaluate_model,
    compare_models,
    predict_load,
)

plt.rcParams["figure.figsize"] = (10, 6)
plt.rcParams["axes.grid"] = True

# %%
# Generate and prepare data
df = generate_dataset(num_days=90, seed=42)
feat = prepare_features(df)
splits = split_and_scale(feat["X"], feat["y"])

X_train, X_test = splits["X_train"], splits["X_test"]
y_train, y_test = splits["y_train"], splits["y_test"]

print(f"Training samples: {X_train.shape[0]}")
print(f"Test samples:     {X_test.shape[0]}")
print(f"Features:         {feat['feature_names']}")

# %%
# ── Model 1: Linear Regression ─────────────────────────────────────────────
lr = train_linear_regression(X_train, y_train)
lr_result = evaluate_model(lr, X_test, y_test, "Linear Regression")

print("Linear Regression")
print(f"  Coefficients: {dict(zip(feat['feature_names'], lr.coef_.round(4)))}")
print(f"  Intercept:    {lr.intercept_:.4f}")
print(f"  MAE:          {lr_result['mae']:.4f} kW")
print(f"  RMSE:         {lr_result['rmse']:.4f} kW")
print(f"  R²:           {lr_result['r2']:.4f}")

# %%
# ── Model 2: Polynomial Regression ─────────────────────────────────────────
pr, poly = train_polynomial_regression(X_train, y_train, degree=2)
pr_result = evaluate_model(pr, X_test, y_test, "Polynomial Regression", poly=poly)

print("Polynomial Regression (degree=2)")
print(f"  MAE:  {pr_result['mae']:.4f} kW")
print(f"  RMSE: {pr_result['rmse']:.4f} kW")
print(f"  R²:   {pr_result['r2']:.4f}")

# %%
# ── Model 3: Random Forest ─────────────────────────────────────────────────
rf = train_random_forest(X_train, y_train, n_estimators=100)
rf_result = evaluate_model(rf, X_test, y_test, "Random Forest")

print("Random Forest (n_estimators=100)")
print(f"  MAE:  {rf_result['mae']:.4f} kW")
print(f"  RMSE: {rf_result['rmse']:.4f} kW")
print(f"  R²:   {rf_result['r2']:.4f}")

# Feature importances
print(f"\n  Feature Importances:")
for name, imp in zip(feat["feature_names"], rf.feature_importances_):
    print(f"    {name:15s} → {imp:.4f}")

# %%
# ── Comparison Table ────────────────────────────────────────────────────────
comparison = compare_models([lr_result, pr_result, rf_result])
print("\n" + "=" * 55)
print("  MODEL COMPARISON")
print("=" * 55)
print(comparison.to_string(index=False))
print("=" * 55)

best = comparison.loc[comparison["R²"].idxmax()]
print(f"\nBest model: {best['Model']} (R² = {best['R²']})")

# %%
# ── Actual vs Predicted Plots ──────────────────────────────────────────────
fig, axes = plt.subplots(1, 3, figsize=(18, 5))

for ax, (name, result) in zip(axes, [
    ("Linear", lr_result), ("Polynomial", pr_result), ("Random Forest", rf_result)
]):
    ax.scatter(y_test, result["y_pred"], alpha=0.4, s=15, color="#e74c3c", edgecolors="none")
    lims = [min(y_test.min(), result["y_pred"].min()) - 10,
            max(y_test.max(), result["y_pred"].max()) + 10]
    ax.plot(lims, lims, "--", color="#2c3e50", linewidth=1.5)
    ax.set_xlabel("Actual Load (kW)")
    ax.set_ylabel("Predicted Load (kW)")
    ax.set_title(f"{name}\nR² = {result['r2']:.4f}", fontweight="bold")
    ax.set_aspect("equal")

plt.tight_layout()
plt.savefig("../outputs/figures/regression_actual_vs_predicted.png", dpi=150, bbox_inches="tight")
plt.show()

# %%
# ── Model Comparison Bar Chart ─────────────────────────────────────────────
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

metrics = [("MAE (kW)", "#95a5a6"), ("RMSE (kW)", "#f39c12"), ("R²", "#27ae60")]
for ax, (col, color) in zip(axes, metrics):
    bars = ax.bar(comparison["Model"], comparison[col], color=color, edgecolor="white", width=0.6)
    ax.set_title(col, fontweight="bold")
    for bar, val in zip(bars, comparison[col]):
        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.01 * bar.get_height(),
                f"{val:.4f}", ha="center", va="bottom", fontsize=10, fontweight="bold")
    ax.tick_params(axis="x", rotation=20)

plt.suptitle("Regression Model Comparison", fontweight="bold", fontsize=14, y=1.02)
plt.tight_layout()
plt.savefig("../outputs/figures/regression_model_comparison.png", dpi=150, bbox_inches="tight")
plt.show()

print("Model training complete.")
