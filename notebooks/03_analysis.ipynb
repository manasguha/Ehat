"""
Notebook 3: Advanced Analysis — Sensitivity, 3D Surface, What-If
"""

# %%
import sys
sys.path.insert(0, "../src")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

from data_generator import generate_dataset, STATION_CAPACITY_KW
from preprocessing import prepare_features, split_and_scale
from models import (
    train_random_forest,
    train_polynomial_regression,
    predict_load,
)

plt.rcParams["figure.figsize"] = (10, 6)
plt.rcParams["axes.grid"] = True

# %%
# Train best model
df = generate_dataset(num_days=90, seed=42)
feat = prepare_features(df)
splits = split_and_scale(feat["X"], feat["y"])

rf = train_random_forest(splits["X_train"], splits["y_train"], n_estimators=100)
pr, poly = train_polynomial_regression(splits["X_train"], splits["y_train"], degree=2)

print("Models trained.")

# %%
# ── Sensitivity Analysis ───────────────────────────────────────────────────
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))

# Vehicles sensitivity at 18:00
veh_range = np.arange(0, 61, 5)
loads_v = []
for v in veh_range:
    hs = np.sin(2 * np.pi * 18 / 24)
    hc = np.cos(2 * np.pi * 18 / 24)
    loads_v.append(predict_load(rf, hs, hc, v))

ax1.plot(veh_range, loads_v, color="#e74c3c", linewidth=2.5, marker="o", markersize=5)
ax1.fill_between(veh_range, loads_v, alpha=0.15, color="#e74c3c")
ax1.set_xlabel("Number of Vehicles")
ax1.set_ylabel("Predicted Load (kW)")
ax1.set_title("Sensitivity: Vehicles (at 18:00)", fontweight="bold")
ax1.axhline(y=STATION_CAPACITY_KW, color="red", linestyle="--", alpha=0.5, label="Capacity")
ax1.legend()

# Time sensitivity at 40 vehicles
hour_range = np.linspace(0, 23, 96)
loads_h = []
for h in hour_range:
    hs = np.sin(2 * np.pi * h / 24)
    hc = np.cos(2 * np.pi * h / 24)
    loads_h.append(predict_load(rf, hs, hc, 40))

ax2.plot(hour_range, loads_h, color="#3498db", linewidth=2.5)
ax2.fill_between(hour_range, loads_h, alpha=0.15, color="#3498db")
ax2.set_xlabel("Hour of Day")
ax2.set_ylabel("Predicted Load (kW)")
ax2.set_title("Sensitivity: Time (at 40 vehicles)", fontweight="bold")
ax2.set_xticks(range(0, 24, 4))
ax2.set_xticklabels([f"{h:02d}:00" for h in range(0, 24, 4)])
ax2.axhline(y=STATION_CAPACITY_KW, color="red", linestyle="--", alpha=0.5, label="Capacity")
ax2.legend()

plt.suptitle("Sensitivity Analysis", fontweight="bold", fontsize=14, y=1.02)
plt.tight_layout()
plt.savefig("../outputs/figures/analysis_sensitivity.png", dpi=150, bbox_inches="tight")
plt.show()

# %%
# ── 3D Load Surface ────────────────────────────────────────────────────────
hours = np.linspace(0, 23, 80)
vehicles = np.linspace(0, 60, 80)
H, V = np.meshgrid(hours, vehicles)

hour_sin = np.sin(2 * np.pi * H / 24)
hour_cos = np.cos(2 * np.pi * H / 24)

X_grid = np.column_stack([hour_sin.ravel(), hour_cos.ravel(), V.ravel()])
Z = rf.predict(X_grid).reshape(H.shape)
Z = np.clip(Z, 0, STATION_CAPACITY_KW)

fig = plt.figure(figsize=(12, 8))
ax = fig.add_subplot(111, projection="3d")

surf = ax.plot_surface(H, V, Z, cmap="RdYlGn_r", alpha=0.85, edgecolor="none")

ax.set_xlabel("Hour of Day", labelpad=10)
ax.set_ylabel("Number of Vehicles", labelpad=10)
ax.set_zlabel("Load (kW)", labelpad=10)
ax.set_title("3D Load Surface: Time × Vehicles → Load", fontweight="bold", pad=20)
ax.view_init(elev=25, azim=225)

fig.colorbar(surf, shrink=0.5, aspect=15, label="Load (kW)")
plt.tight_layout()
plt.savefig("../outputs/figures/analysis_3d_surface.png", dpi=150, bbox_inches="tight")
plt.show()

# %%
# ── What-If Scenario Table ─────────────────────────────────────────────────
scenarios = [
    ("A", "08:00", 20, "Morning commute"),
    ("B", "18:00", 20, "Evening, few vehicles"),
    ("C", "18:00", 40, "Evening, many vehicles"),
    ("D", "20:00", 60, "Peak demand"),
    ("E", "03:00", 5, "Late night"),
    ("F", "12:00", 35, "Midday"),
]

print("\n" + "=" * 70)
print("  WHAT-IF SCENARIO ANALYSIS")
print("=" * 70)
print(f"{'Scenario':<10} {'Time':<8} {'Vehicles':<10} {'Load (kW)':<12} {'Status'}")
print("-" * 70)

for label, time_str, veh, desc in scenarios:
    h = int(time_str.split(":")[0])
    hs = np.sin(2 * np.pi * h / 24)
    hc = np.cos(2 * np.pi * h / 24)
    pred = predict_load(rf, hs, hc, veh)
    status = "⚠️  PEAK" if pred > 270 else ("⚡ HIGH" if pred > 200 else "✅ NORMAL")
    print(f"{label:<10} {time_str:<8} {veh:<10} {pred:<12.1f} {status}  ({desc})")

print("=" * 70)

# %%
# ── Feature Importance ─────────────────────────────────────────────────────
importances = rf.feature_importances_
names = feat["feature_names"]
indices = np.argsort(importances)

fig, ax = plt.subplots(figsize=(8, 4))
bars = ax.barh([names[i] for i in indices], importances[indices],
               color="#27ae60", edgecolor="white", height=0.5)
for bar, val in zip(bars, importances[indices]):
    ax.text(bar.get_width() + 0.01, bar.get_y() + bar.get_height() / 2,
            f"{val:.3f}", va="center", fontsize=11, fontweight="bold")
ax.set_xlabel("Importance")
ax.set_title("Feature Importance — Random Forest", fontweight="bold", pad=15)
plt.tight_layout()
plt.savefig("../outputs/figures/analysis_feature_importance.png", dpi=150, bbox_inches="tight")
plt.show()

# %%
# ── Peak Load Warning Demo ─────────────────────────────────────────────────
print(f"\nStation Capacity: {STATION_CAPACITY_KW} kW")
print("\nPeak Load Warning Demonstration:")
print("-" * 50)

test_cases = [
    (8, 20), (18, 40), (20, 60), (3, 5), (12, 35),
]
for h, v in test_cases:
    hs = np.sin(2 * np.pi * h / 24)
    hc = np.cos(2 * np.pi * h / 24)
    pred = predict_load(rf, hs, hc, v)
    util = (pred / STATION_CAPACITY_KW) * 100
    status = "PEAK WARNING" if pred > 270 else ("HIGH LOAD" if pred > 200 else "NORMAL")
    print(f"  {h:02d}:00 | {v:2d} vehicles | {pred:6.1f} kW | {util:5.1f}% util | {status}")

print("-" * 50)
print("Analysis complete.")
